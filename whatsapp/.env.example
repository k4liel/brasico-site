# Copie para .env na VPS (cp .env.example .env) e preencha.
# O .env nunca vai para o GitHub.

# Endereço público da VPS (troque pelo IP ou domínio dela)
SERVER_URL=http://IP-DA-VPS:8080

# Senha da Evolution (manager e API). Gere uma longa: openssl rand -hex 32
AUTHENTICATION_API_KEY=troque-por-uma-senha-longa

# Senha do banco interno da Evolution. Gere outra: openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-outra-senha

# Para onde vão as mensagens. O segredo está no Supabase:
# painel do Supabase > Integrations > Vault > wa_segredo (botão de ver o valor)
WEBHOOK_URL=https://doajznzouxxqbqkvsclv.supabase.co/functions/v1/whatsapp-webhook?segredo=COLE-O-wa_segredo-AQUI
